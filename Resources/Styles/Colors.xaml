<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Mismo morado que el escritorio (DeepPurple 500 de MaterialDesignThemes, #673AB7) -->
    <Color x:Key="Primary">#673AB7</Color>
    <Color x:Key="PrimaryDark">#B39DDB</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#EDE7F6</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#4527A0</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ── Superficies de contenido ──────────────────────────────────────────────
         Añadidas para que las tarjetas y los chips de la ficha no sean el lavanda
         fijo Secondary en modo oscuro. Se usan siempre por pares con
         AppThemeBinding (Light=…Light, Dark=…Dark) en las páginas; el par mantiene
         la misma familia morada que la marca, solo cambia de valor.
         Todo lo de arriba se conserva tal cual: esto es aditivo. -->

    <!-- Fondo de tarjeta/chip: el lavanda de siempre en claro, un morado casi negro en oscuro -->
    <Color x:Key="SurfaceCardLight">#EDE7F6</Color>
    <Color x:Key="SurfaceCardDark">#241F2E</Color>

    <!-- Línea divisoria y borde de tarjeta -->
    <Color x:Key="SurfaceLineLight">#DCD3EC</Color>
    <Color x:Key="SurfaceLineDark">#3A3346</Color>

    <!-- Texto principal sobre esas superficies -->
    <Color x:Key="OnSurfaceLight">#241F2E</Color>
    <Color x:Key="OnSurfaceDark">#EDEAF3</Color>

    <!-- Texto secundario (antes Gray500 en claro, ilegible en oscuro) -->
    <Color x:Key="TextMutedLight">#6E6E6E</Color>
    <Color x:Key="TextMutedDark">#A79FB5</Color>

    <!-- Texto y accento sobre una carátula (el degradado oscuro es igual en ambos
         modos, así que estos NO llevan AppThemeBinding). Sustituye al #DDDDDD suelto. -->
    <Color x:Key="OnCover">#F2F0F7</Color>
    <Color x:Key="OnCoverMuted">#C6C0D4</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>
