<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoGameLibraryAndroid.Presentation.ViewModels"
             x:Class="VideoGameLibraryAndroid.Presentation.Views.GameCandidatePickerPage"
             Title="Varios resultados">

    <Grid RowDefinitions="Auto,*,Auto">

        <Label Grid.Row="0" Text="Se han encontrado varios juegos que coinciden. Elige el correcto."
               FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
               Padding="20,16,20,4" />

        <CollectionView Grid.Row="1" x:Name="CandidatesList" SelectionMode="None" Margin="0,4,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CandidateItem">
                    <Border Margin="12,4" Padding="10" StrokeShape="RoundRectangle 10"
                            Stroke="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}"
                            StrokeThickness="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCandidateTapped" />
                        </Border.GestureRecognizers>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                            <Border Grid.Column="0" WidthRequest="48" HeightRequest="48" Padding="0"
                                    StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                    BackgroundColor="{StaticResource Primary}">
                                <Image Source="{Binding CoverImageSource}" Aspect="AspectFill" IsVisible="{Binding HasCover}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14"
                                       LineBreakMode="TailTruncation" MaxLines="2" />
                                <Label FontSize="12" TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Platform}" />
                                            <Span Text=" · " />
                                            <Span Text="{Binding YearText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="CANCELAR" Clicked="OnCancelClicked" Margin="20,10,20,16"
                BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource Primary}" />

    </Grid>

</ContentPage>
