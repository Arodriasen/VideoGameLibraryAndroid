<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoGameLibraryAndroid.Presentation.ViewModels"
             xmlns:conv="clr-namespace:VideoGameLibraryAndroid.Presentation.Converters"
             x:Class="VideoGameLibraryAndroid.Presentation.Views.GameDetailPage"
             x:DataType="vm:GameDetailViewModel"
             Title="Ficha del juego">

    <ContentPage.Resources>
        <conv:RatingToStarColorConverter x:Key="RatingToStarColor" />
        <conv:RatingToStarSourceConverter x:Key="RatingToStarSource" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero a todo el ancho: mismo lenguaje visual "póster" que las tarjetas de la lista
                 (carátula + degradado + título/plataforma/estrellas superpuestos en blanco). -->
            <Grid HeightRequest="320"
                  Background="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
                <!-- AspectFit (no AspectFill): a diferencia de la tarjeta pequeña de la lista, aquí
                     se quiere ver la carátula completa sin recortar. AspectFill nunca deforma la
                     imagen (nada la "estira", conserva proporción y recorta el sobrante), pero en un
                     hueco ancho y bajo como este recortaba tanto una carátula vertical típica que se
                     veía irreconocible. Con AspectFit se ve entera, con una franja de color a los
                     lados si hace falta (el fondo de arriba). -->
                <Image Source="{Binding CoverImageSource}" Aspect="AspectFit"
                       IsVisible="{Binding HasCover}" />
                <Grid Background="{StaticResource Primary}"
                      IsVisible="{Binding HasCover, Converter={StaticResource InvertedBoolConverter}}">
                    <Image Source="app_logo.svg" HeightRequest="96" WidthRequest="96" Opacity="0.55"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Grid>

                <BoxView VerticalOptions="End" HeightRequest="180">
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0.0" />
                            <GradientStop Color="#E6000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>

                <!-- COMPARTIR/EDITAR/ELIMINAR: solo icono, flotando sobre la portada (círculo
                     blanco de fondo para que se vean igual de bien sobre cualquier carátula).
                     48 px en vez de 40: mínimo táctil de Android. -->
                <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="0,12,12,0" Spacing="10">
                    <ImageButton Source="icon_share.svg" Command="{Binding ShareCommand}"
                                 WidthRequest="48" HeightRequest="48" Padding="12" CornerRadius="24"
                                 BackgroundColor="White"
                                 SemanticProperties.Description="Compartir juego" />
                    <ImageButton Source="icon_pencil.svg" Command="{Binding EditCommand}"
                                 WidthRequest="48" HeightRequest="48" Padding="12" CornerRadius="24"
                                 BackgroundColor="White"
                                 SemanticProperties.Description="Editar juego" />
                    <ImageButton Source="icon_trash_red.svg" Command="{Binding DeleteCommand}"
                                 WidthRequest="48" HeightRequest="48" Padding="12" CornerRadius="24"
                                 BackgroundColor="White"
                                 SemanticProperties.Description="Eliminar juego" />
                </HorizontalStackLayout>

                <VerticalStackLayout VerticalOptions="End" Padding="16,12" Spacing="5">
                    <Label Text="{Binding Title}" FontSize="26" FontAttributes="Bold"
                           TextColor="{StaticResource OnCover}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding Platform}" FontSize="15" TextColor="{StaticResource OnCoverMuted}" />
                    <!-- Estrellas propias en SVG (20 px) en vez del carácter "★", más el número junto
                         a ellas: son el único dato de valoración de la ficha, deben leerse de un
                         vistazo. -->
                    <HorizontalStackLayout Spacing="3" Margin="0,3,0,0">
                        <Image Source="{Binding Rating, Converter={StaticResource RatingToStarSource}, ConverterParameter=1}" HeightRequest="20" WidthRequest="20" />
                        <Image Source="{Binding Rating, Converter={StaticResource RatingToStarSource}, ConverterParameter=2}" HeightRequest="20" WidthRequest="20" />
                        <Image Source="{Binding Rating, Converter={StaticResource RatingToStarSource}, ConverterParameter=3}" HeightRequest="20" WidthRequest="20" />
                        <Image Source="{Binding Rating, Converter={StaticResource RatingToStarSource}, ConverterParameter=4}" HeightRequest="20" WidthRequest="20" />
                        <Image Source="{Binding Rating, Converter={StaticResource RatingToStarSource}, ConverterParameter=5}" HeightRequest="20" WidthRequest="20" />
                        <Label Text="{Binding RatingText}" IsVisible="{Binding HasRating}" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource OnCover}" Margin="4,0,0,0" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16,18,16,32" Spacing="22">

                <!-- Jugado / Deseados como pastillas pulsables, mismo lenguaje visual que el
                     segmentado Colección/Deseados de MainPage: activo = relleno morado + texto
                     blanco, inactivo = solo borde + texto atenuado. Sustituyen a la fila "Jugado"
                     de la lista secundaria y al chip "Lista de deseos" que antes flotaba sobre la
                     carátula; aquí, además, se puede tocar para cambiar el estado sin pasar por
                     Editar (TogglePlayedCommand/ToggleWishlistCommand guardan al momento). -->
                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 18" StrokeThickness="1.5" Padding="16,0" HeightRequest="38">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePlayedCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Played}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Label Text="Jugado" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" InputTransparent="True">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Played}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Border>

                    <Border Grid.Column="1" StrokeShape="RoundRectangle 18" StrokeThickness="1.5" Padding="16,0" HeightRequest="38">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleWishlistCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BackgroundColor" Value="Transparent" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}" />
                                <Style.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsWishlist}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                        <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Label Text="Deseados" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" InputTransparent="True">
                            <Label.Style>
                                <Style TargetType="Label">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    <Setter Property="FontAttributes" Value="None" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsWishlist}" Value="True">
                                            <Setter Property="TextColor" Value="White" />
                                            <Setter Property="FontAttributes" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Label.Style>
                        </Label>
                    </Border>
                </Grid>

                <!-- NIVEL 1: los tres datos que de verdad identifican el juego, en una sola
                     rejilla unificada (antes eran tres tarjetas lavanda sueltas con el mismo peso
                     que Jugado y Código de barras, y los cinco competían entre sí). -->
                <Border StrokeShape="RoundRectangle 10"
                        Stroke="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}"
                        StrokeThickness="1" Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
                    <Grid ColumnDefinitions="*,Auto,*,Auto,*" Padding="0,12">
                        <VerticalStackLayout Grid.Column="0" Padding="12,0" Spacing="3">
                            <Label Text="GÉNERO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Genre}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="1" WidthRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}" />

                        <VerticalStackLayout Grid.Column="2" Padding="12,0" Spacing="3">
                            <Label Text="EDITORIAL" FontSize="10" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding Publisher}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <BoxView Grid.Column="3" WidthRequest="1"
                                 Color="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}"
                                 BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}" />

                        <VerticalStackLayout Grid.Column="4" Padding="12,0" Spacing="3">
                            <Label Text="AÑO" FontSize="10" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            <Label Text="{Binding YearText}" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- NIVEL 2: etiquetas como chips sueltos, ahora con borde en vez de relleno
                     lavanda, para que no pesen lo mismo que la rejilla de arriba. Se quita el
                     emoji 🏷 y también la cabecera "ETIQUETAS": el chip con la etiqueta puesta
                     ya se entiende solo, sin necesitar un rótulo encima. -->
                <VerticalStackLayout IsVisible="{Binding HasTags}" Spacing="8">
                    <FlexLayout Wrap="Wrap" Direction="Row"
                                BindableLayout.ItemsSource="{Binding TagList}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeShape="RoundRectangle 14"
                                        Stroke="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}"
                                        StrokeThickness="1" BackgroundColor="Transparent"
                                        Padding="11,5" Margin="0,0,6,6">
                                    <Label Text="{Binding}" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- NIVEL 2: notas, sin caja, el texto largo se lee mejor sin marco. -->
                <VerticalStackLayout IsVisible="{Binding HasNotes}" Spacing="6">
                    <Label Text="NOTAS" FontSize="10" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                    <Label Text="{Binding Notes}" FontSize="14" LineHeight="1.45"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                </VerticalStackLayout>

                <!-- NIVEL 3: lo secundario (Código de barras, fecha de alta) baja a una lista
                     discreta etiqueta/valor con una línea divisoria arriba: presente, consultable,
                     y sin robarle atención a Género/Editorial/Año. Jugado ya no vive aquí: ahora
                     es una pastilla pulsable arriba, junto a Deseados. -->
                <VerticalStackLayout Spacing="0">
                    <BoxView HeightRequest="1" Margin="0,0,0,10"
                             Color="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}"
                             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLineLight}, Dark={StaticResource SurfaceLineDark}}" />

                    <Grid ColumnDefinitions="150,*" Padding="0,7" IsVisible="{Binding HasBarcode}">
                        <Label Grid.Column="0" Text="Código de barras" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        <Label Grid.Column="1" Text="{Binding Barcode}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                               LineBreakMode="TailTruncation" />
                    </Grid>

                    <Grid ColumnDefinitions="150,*" Padding="0,7">
                        <Label Grid.Column="0" Text="En la colección desde" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        <Label Grid.Column="1" Text="{Binding AddedDateText}" FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
