<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:VideoGameLibraryAndroid.Presentation.ViewModels"
             x:Class="VideoGameLibraryAndroid.Presentation.Views.ForgotPasswordPage"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Recuperar contraseña">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Paso 1: pedir el código por correo -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCodeStep, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="Te enviaremos un código a tu correo para que puedas poner una contraseña nueva." FontSize="13" />
                <Entry Placeholder="Correo electrónico" Text="{Binding Email}" Keyboard="Email" />
                <Button Text="ENVIAR CÓDIGO" Command="{Binding SendCodeCommand}" />
            </VerticalStackLayout>

            <!-- Paso 2: código recibido + contraseña nueva -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsCodeStep}">
                <Label Text="Introduce el código que has recibido por correo y tu contraseña nueva." FontSize="13" />
                <Entry Placeholder="Código recibido por correo" Text="{Binding Code}" Keyboard="Numeric" />
                <Entry Placeholder="Contraseña nueva" Text="{Binding NewPassword}" IsPassword="True" />
                <Entry Placeholder="Repite la contraseña nueva" Text="{Binding ConfirmPassword}" IsPassword="True" />
                <Button Text="CAMBIAR CONTRASEÑA" Command="{Binding ResetPasswordCommand}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
